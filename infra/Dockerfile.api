# syntax=docker/dockerfile:1.7

# ==================================================
# BUILDER
# ==================================================
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# --------------------------------------------------
# Primeiro: somente os manifests e o lockfile.
# Mantém o cache de dependências quando o código muda.
# --------------------------------------------------
COPY pyproject.toml uv.lock ./

# Manifests de todos os membros do workspace.
COPY packages/agentes/pyproject.toml ./packages/agentes/pyproject.toml
COPY packages/contratos/pyproject.toml ./packages/contratos/pyproject.toml
COPY packages/extracao/pyproject.toml ./packages/extracao/pyproject.toml
COPY packages/motor/pyproject.toml ./packages/motor/pyproject.toml
COPY packages/rag/pyproject.toml ./packages/rag/pyproject.toml
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml

# Instala dependências de terceiros sem instalar
# os pacotes do workspace nesta primeira etapa.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
      --locked \
      --no-dev \
      --no-default-groups \
      --package fa-api \
      --no-install-workspace

# --------------------------------------------------
# Código-fonte: copiado somente depois da resolução
# e instalação das dependências externas.
# --------------------------------------------------
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Instala a API e os pacotes locais de que ela depende.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
      --locked \
      --no-dev \
      --no-default-groups \
      --package fa-api

# ==================================================
# RUNTIME
# ==================================================
FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FA_API_HOST=0.0.0.0 \
    FA_API_PORT=8000

WORKDIR /app

# Usuário sem privilégios.
RUN groupadd --system --gid 10001 aplicacao \
    && useradd \
      --system \
      --uid 10001 \
      --gid aplicacao \
      --create-home \
      --home-dir /home/aplicacao \
      aplicacao

# Ambiente Python instalado no builder.
COPY --from=builder --chown=aplicacao:aplicacao \
  /opt/venv /opt/venv

# Os pacotes locais são instalações editáveis do workspace e precisam estar no runtime.
COPY --from=builder --chown=aplicacao:aplicacao \
  /app/packages/agentes /app/packages/agentes
COPY --from=builder --chown=aplicacao:aplicacao \
  /app/packages/contratos /app/packages/contratos
COPY --from=builder --chown=aplicacao:aplicacao \
  /app/packages/motor /app/packages/motor
COPY --from=builder --chown=aplicacao:aplicacao \
  /app/apps/api /app/apps/api

USER aplicacao

EXPOSE 8000

# Consome as variáveis configuradas no .env.
CMD [ "sh", "-c", "exec uvicorn fa_api.main:app --host \"${FA_API_HOST:-0.0.0.0}\" --port \"${FA_API_PORT:-8000}\"" ]
