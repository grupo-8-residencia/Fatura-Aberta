# Copie para .env (que é ignorado pelo Git) e preencha localmente.
# NUNCA coloque valores reais neste arquivo de exemplo.

# API
FA_API_HOST=0.0.0.0
FA_API_PORT=8000
# Origens da interface, separadas por vírgula. Em produção, use a URL HTTPS exata.
# FA_CORS_ORIGINS=https://seu-frontend.example

# LLM do experimento (F5). Padrão: cliente falso, sem rede (é o que o CI usa).
# Para rodar de verdade com o Ollama local (ADR-002):
# FA_LLM_PROVEDOR=ollama
# FA_LLM_MODELO=gpt-oss:20b
# FA_LLM_JUIZ_MODELO=qwen3:14b
# FA_LLM_URL=http://localhost:11434

# Leitura de foto da fatura (F4, #40): modelo de visão local no Ollama. Sem estas variáveis, usa
# qwen2.5vl:3b (escolhido pela medição em fotos sintéticas, #41) e a URL do FA_LLM_URL ou o Ollama local.
# FA_VLM_MODELO=qwen2.5vl:3b
# FA_VLM_URL=http://localhost:11434
# FA_VLM_TIMEOUT_S=300

# Limites da API (valores padrão no código; defina só para mudar). PDF: 5 MB e 5 páginas.
# Leitura do PDF: 30 s. Agentes: 15 s e 2 análises simultâneas. Embedder do RAG: hash (local).
# FA_PDF_MAX_BYTES=5242880
# FA_PDF_MAX_PAGINAS=5
# FA_EXTRACAO_TIMEOUT_S=30
# FA_AGENTES_TIMEOUT_S=15
# FA_AGENTES_CONCORRENCIA=2
# FA_RAG_EMBEDDER=hash

# Web (apps/web): URL pública da API usada pelo navegador. Padrão: http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Reservado para um provedor remoto, se o time decidir; nunca coloque a chave aqui:
# FA_LLM_API_KEY=
