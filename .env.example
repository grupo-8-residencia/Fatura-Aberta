# Copie para .env (que é ignorado pelo Git) e preencha localmente.
# NUNCA coloque valores reais neste arquivo de exemplo.

# API
FA_API_HOST=0.0.0.0
FA_API_PORT=8000
# Origens da interface, separadas por vírgula. Em produção, use a URL HTTPS exata.
# FA_CORS_ORIGINS=https://seu-frontend.example

# LLM do experimento (F5). Padrão: cliente falso, sem rede (é o que o CI usa).
# Para rodar de verdade com o Ollama local (ADR-002):
# FA_LLM_PROVEDOR=ollama
# FA_LLM_MODELO=gpt-oss:20b
# FA_LLM_JUIZ_MODELO=qwen3:14b
# FA_LLM_URL=http://localhost:11434
# Reservado para um provedor remoto, se o time decidir; nunca coloque a chave aqui:
# FA_LLM_API_KEY=
